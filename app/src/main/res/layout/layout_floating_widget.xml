<?xml version="1.0" encoding="utf-8"?>
<!-- WidgetPillLayout = LinearLayout + долгое нажатие открывает Taxi Radar -->
<!-- Сверху — кружок с надбавкой, под ним по центру — «+» (метки на дороге) -->
<com.example.taxiradar.WidgetPillLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widgetPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_pill"
        android:gravity="center"
        android:minWidth="72dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvWidgetSurge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:text="…"
            android:textColor="@color/tr_accent"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="220dp"
            android:textColor="@color/tr_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- «+»: отметить на дороге то, что видит водитель, — увидят все -->
        <LinearLayout
            android:id="@+id/layoutReportMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnRepRadar"
                style="@style/WidgetReportButton"
                android:text="📸" />

            <TextView
                android:id="@+id/btnRepPolice"
                style="@style/WidgetReportButton"
                android:text="🚓" />

            <TextView
                android:id="@+id/btnRepDanger"
                style="@style/WidgetReportButton"
                android:text="⚠️" />
        </LinearLayout>
    </LinearLayout>

    <!-- Чуть заходит на кружок снизу; рисуется поверх него -->
    <TextView
        android:id="@+id/btnWidgetPlus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="-9dp"
        android:background="@drawable/bg_widget_plus"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="@color/tr_accent"
        android:textSize="20sp"
        android:textStyle="bold" />
</com.example.taxiradar.WidgetPillLayout>
