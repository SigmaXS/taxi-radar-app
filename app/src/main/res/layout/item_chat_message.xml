<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble"
        android:maxWidth="300dp"
        android:minWidth="80dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvMsgNick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tr_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMsgText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web|phone"
            android:maxWidth="276dp"
            android:textColor="@color/tr_text"
            android:textColorLink="@color/tr_accent"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvMsgTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/tr_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
