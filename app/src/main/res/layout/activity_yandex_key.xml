<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/tr_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/keyweb_title"
            android:textColor="@color/tr_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyDesktop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/keyweb_desktop"
            android:textColor="@color/tr_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyBrowser"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/keyweb_in_browser"
            app:icon="@drawable/ic_open_in_new"
            app:iconTint="@color/tr_text_secondary" />
    </LinearLayout>

    <!-- Что происходит: подсказка → «нашли, проверяем» → «готово» -->
    <LinearLayout
        android:id="@+id/layoutKeyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tr_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/ivKeyStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_help"
            app:tint="@color/tr_accent" />

        <TextView
            android:id="@+id/tvKeyStatus"
            style="@style/TaxiRadar.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/keyweb_hint"
            android:textColor="@color/tr_text" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/tr_accent"
        app:trackColor="@color/tr_surface" />

    <WebView
        android:id="@+id/webKey"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
