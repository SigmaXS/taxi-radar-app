<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_bg">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvMapNoKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="110dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/map_no_tiles"
        android:textColor="@color/tr_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Верхняя панель + слои -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_title"
                android:textColor="@color/tr_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_hint"
                android:textColor="@color/tr_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLayerRoad"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_layer_road" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLayerAddr"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_layer_addr" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLayerPlaces"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_layer_places" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMapDark"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/map_dark" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRoadAlerts"
                style="@style/Widget.Material3.Chip.Filter.Elevated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_road_alerts" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/map_add_report"
        android:textColor="@color/tr_on_accent"
        app:backgroundTint="@color/tr_accent"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/tr_on_accent" />

    <!-- «Я здесь» — такая же круглая кнопка, как «+ Метка» -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnMapMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/map_i_am_here"
        android:textColor="@color/tr_text"
        app:backgroundTint="@color/tr_surface_high"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/tr_accent" />
</FrameLayout>
