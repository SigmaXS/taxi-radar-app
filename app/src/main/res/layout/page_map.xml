<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tr_bg">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvMapNoKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="110dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/map_no_tiles"
        android:textColor="@color/tr_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Верхняя панель: поиск адреса + кнопка слоёв -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/tr_text_secondary" />

            <EditText
                android:id="@+id/etMapSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/map_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:textColor="@color/tr_text"
                android:textColorHint="@color/tr_text_muted"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnMapLayers"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_layers"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                app:tint="@color/tr_accent" />
        </LinearLayout>

        <!-- Слои и подсказка — по кнопке, чтобы не закрывали карту -->
        <LinearLayout
            android:id="@+id/layoutMapLayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_widget_pill"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_hint"
                android:textColor="@color/tr_text_secondary"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="6dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerRoad"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/map_layer_road" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerAddr"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/map_layer_addr" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLayerPlaces"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/map_layer_places" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMapDark"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/map_dark" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRoadAlerts"
                    style="@style/Widget.Material3.Chip.Filter.Elevated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_road_alerts" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Компас: виден, когда карту повернули; нажатие — север вверх -->
        <ImageButton
            android:id="@+id/btnMapCompass"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_widget_pill"
            android:contentDescription="@string/map_north"
            android:src="@drawable/ic_compass"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/map_add_report"
        android:textColor="@color/tr_on_accent"
        app:backgroundTint="@color/tr_accent"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/tr_on_accent" />

    <!-- «Я здесь» — такая же круглая кнопка, как «+ Метка» -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnMapMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:text="@string/map_i_am_here"
        android:textColor="@color/tr_text"
        app:backgroundTint="@color/tr_surface_high"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@color/tr_accent" />
</FrameLayout>
